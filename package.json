{
  "name": "nest-admin-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Nest-Admin-Pro 全栈后台管理系统根 workspace",
  "scripts": {
    "backend:dev": "npm --prefix apps/backend run start:dev",
    "backend:build": "npm --prefix apps/backend run build",
    "backend:prisma:generate": "npm --prefix apps/backend run prisma:generate",
    "backend:prisma:push": "npm --prefix apps/backend run prisma:push",
    "app:dev:h5": "npm --prefix apps/app run dev:h5",
    "app:dev:mp-weixin": "npm --prefix apps/app run dev:mp-weixin",
    "app:build:h5": "npm --prefix apps/app run build:h5",
    "vben:install": "pnpm --dir apps/vben-admin install",
    "vben:dev": "pnpm --dir apps/vben-admin dev:antd",
    "vben:build": "pnpm --dir apps/vben-admin build:antd"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.2.2"
}
