APP_NAME=Nest-Admin-Pro
APP_PORT=3000
APP_ENV=development
LOG_LEVEL=info

DATABASE_URL=mysql://root:password@localhost:3306/nest_admin_pro

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=nap:

JWT_SECRET=change-me-please
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-too-please
JWT_REFRESH_EXPIRES_IN=30d

THROTTLE_TTL=60000
THROTTLE_LIMIT=60
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE=2097152
MAX_FILE_SIZE=104857600
FILE_STORAGE=local
FILE_PUBLIC_URL=http://localhost:3000/file
FILE_CLOUD_REGION=
FILE_CLOUD_BUCKET=
FILE_CLOUD_ACCESS_KEY_ID=
FILE_CLOUD_ACCESS_KEY_SECRET=
FILE_CLOUD_ENDPOINT=
FILE_CLOUD_PREFIX=uploads
FILE_CLOUD_PUBLIC_URL=
FILE_CLOUD_SECURE=true

CAPTCHA_ENABLED=true
CAPTCHA_TTL=120

TENANT_DEFAULT_ID=1
TENANT_PLATFORM_ADMIN_ROLE_CODE=platform_admin

SWAGGER_ENABLED=true
