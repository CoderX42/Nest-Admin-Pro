# ===== 应用 =====
APP_NAME=nest-admin-pro
APP_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
MULTI_DEVICE_LOGIN=false
TZ=Asia/Shanghai
IS_DEMO=false

# ===== 安全 / JWT =====
JWT_SECRET=nest-admin-pro-jwt-secret-please-change-in-production
JWT_EXPIRE=7200
REFRESH_TOKEN_SECRET=nest-admin-pro-refresh-secret-please-change
REFRESH_TOKEN_EXPIRE=2592000

# ===== 数据库 =====
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USERNAME=root
DB_PASSWORD=ywtech2026
DB_DATABASE=nest_admin
DB_SYNCHRONIZE=true
DB_LOGGING=info

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=ywtech2026
REDIS_DB=0

# ===== 限流 =====
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# ===== SMTP（可选） =====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===== 七牛云 OSS（可选） =====
OSS_ACCESSKEY=
OSS_SECRETKEY=
OSS_DOMAIN=
OSS_BUCKET=
OSS_ZONE=z0

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE=10485760
MAX_FILE_SIZE=104857600

# ===== Swagger =====
SWAGGER_TITLE=Nest-Admin-Pro API
SWAGGER_DESC=Nest-Admin-Pro 后台管理 API
SWAGGER_VERSION=1.0.0
