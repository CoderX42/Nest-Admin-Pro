generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ================== 系统核心模块 ==================

// 用户表
model SysUser {
  id        BigInt   @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(200)
  nickname  String   @db.VarChar(50)
  avatar    String   @db.VarChar(255) @default("")
  email     String?  @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  status    Int      @default(1)
  remark    String?  @db.VarChar(500)
  deptId    BigInt?
  postIds   String   @db.VarChar(200) @default("")
  createTime DateTime @default(now())
  updateTime DateTime @updatedAt
  deleteTime DateTime?
  isDelete  Int      @default(0)

  roles     SysRole[]
  dept      SysDept? @relation(fields: [deptId], references: [id])
  loginLog  SysLoginLog[]
  operLog   SysOperLog[]

  @@index([username])
  @@index([deptId])
}

// 角色表
model SysRole {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(50)
  code        String    @unique @db.VarChar(50)
  status      Int       @default(1)
  dataScope   Int       @default(1)
  deptIds     String?   @db.VarChar(200) @default("")
  menuIds     String?   @db.VarChar(500) @default("")
  remark      String?   @db.VarChar(500)
  createTime  DateTime  @default(now())
  updateTime  DateTime  @updatedAt

  users       SysUser[]

  @@index([code])
}

// 部门表（树形）
model SysDept {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(50)
  parentId   BigInt    @default(0)
  sort       Int       @default(0)
  status     Int       @default(1)
  leaderId   BigInt?
  createTime DateTime  @default(now())
  updateTime DateTime  @updatedAt

  children   SysDept[]  @relation("DeptChildren")
  parent     SysDept?   @relation("DeptChildren", fields: [parentId], references: [id])
  users      SysUser[]

  @@index([parentId])
  @@index([sort])
}

// 岗位表
model SysPost {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(50)
  code       String    @unique @db.VarChar(50)
  sort       Int       @default(0)
  status     Int       @default(1)
  remark     String?   @db.VarChar(500)
  createTime DateTime  @default(now())
  updateTime DateTime  @updatedAt

  @@index([code])
  @@index([sort])
}

// 菜单表（树形）
model SysMenu {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(50)
  type        Int       @default(1)
  parentId    BigInt    @default(0)
  path        String?   @db.VarChar(255)
  component   String?   @db.VarChar(255)
  icon        String?   @db.VarChar(100)
  sort        Int       @default(0)
  perms       String?   @db.VarChar(100)
  status      Int       @default(1)
  external    Int       @default(0)
  keepAlive   Int       @default(0)
  show        Int       @default(1)
  createTime  DateTime  @default(now())
  updateTime  DateTime  @updatedAt

  children    SysMenu[]  @relation("MenuChildren")
  parent      SysMenu?   @relation("MenuChildren", fields: [parentId], references: [id])

  @@index([parentId])
  @@index([sort])
  @@index([perms])
}

// 字典类型
model SysDictType {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(50)
  code       String    @unique @db.VarChar(50)
  status     Int       @default(1)
  remark     String?   @db.VarChar(500)
  createTime DateTime  @default(now())
  updateTime DateTime  @updatedAt

  items      SysDictData[]

  @@index([code])
}

// 字典数据
model SysDictData {
  id         BigInt       @id @default(autoincrement())
  dictTypeId BigInt
  label      String       @db.VarChar(100)
  value      String       @db.VarChar(100)
  sort       Int          @default(0)
  status     Int          @default(1)
  remark     String?      @db.VarChar(500)
  createTime DateTime     @default(now())
  updateTime DateTime     @updatedAt

  dictType   SysDictType  @relation(fields: [dictTypeId], references: [id])

  @@index([dictTypeId])
  @@index([sort])
  @@index([value])
}

// 系统配置参数
model SysConfig {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(100)
  key        String    @unique @db.VarChar(100)
  value      String    @db.Text
  type       String    @db.VarChar(20) @default("string")
  remark     String?   @db.VarChar(500)
  status     Int       @default(1)
  createTime DateTime  @default(now())
  updateTime DateTime  @updatedAt

  @@index([key])
}

// 通知公告
model SysNotice {
  id         BigInt    @id @default(autoincrement())
  title      String    @db.VarChar(200)
  content    String    @db.Text
  type       Int       @default(1)
  status     Int       @default(1)
  publishTime DateTime?
  createTime DateTime  @default(now())
  updateTime DateTime  @updatedAt

  @@index([type])
  @@index([status])
}

// ================== 日志监控模块 ==================

// 登录日志
model SysLoginLog {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt?
  username   String    @db.VarChar(50)
  ip         String    @db.VarChar(50)
  location   String?   @db.VarChar(255)
  os         String?   @db.VarChar(100)
  browser    String?   @db.VarChar(100)
  status     Int       @default(1)
  msg        String?   @db.VarChar(255)
  createTime DateTime  @default(now())

  user       SysUser?  @relation(fields: [userId], references: [id])

  @@index([username])
  @@index([ip])
  @@index([createTime])
}

// 操作日志
model SysOperLog {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt?
  username   String    @db.VarChar(50)
  module     String?   @db.VarChar(100)
  method     String?   @db.VarChar(100)
  reqMethod  String?   @db.VarChar(10)
  reqUrl     String    @db.VarChar(255)
  reqParam   String?   @db.Text
  respResult String?   @db.Text
  status     Int       @default(1)
  errorMsg   String?   @db.Text
  duration   Int?
  ip         String?   @db.VarChar(50)
  location   String?   @db.VarChar(255)
  createTime DateTime  @default(now())

  user       SysUser?  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([createTime])
}

// ================== 定时任务模块 ==================

model SysJob {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(100)
  handler    String    @db.VarChar(100)
  cron       String?   @db.VarChar(100)
  interval   Int?
  type       Int       @default(1)
  status     Int       @default(1)
  remark     String?   @db.VarChar(500)
  createTime DateTime  @default(now())
  updateTime DateTime  @updatedAt

  logs       SysJobLog[]

  @@index([handler])
  @@index([status])
}

model SysJobLog {
  id         BigInt    @id @default(autoincrement())
  jobId      BigInt
  status     Int       @default(1)
  resp       String?   @db.Text
  errorMsg   String?   @db.Text
  duration   Int?
  createTime DateTime  @default(now())

  job        SysJob    @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([createTime])
}

// ================== 代码生成模块 ==================

model GenTable {
  id           BigInt    @id @default(autoincrement())
  tableName    String    @db.VarChar(100)
  tableComment String?  @db.VarChar(200)
  moduleName   String    @db.VarChar(50)
  businessName String    @db.VarChar(50)
  entityName   String    @db.VarChar(50)
  author       String    @db.VarChar(50)
  tablePrefix  String?  @db.VarChar(50)
  createTime   DateTime  @default(now())
  updateTime   DateTime  @updatedAt

  fields       GenTableField[]

  @@index([tableName])
}

model GenTableField {
  id            BigInt     @id @default(autoincrement())
  tableId       BigInt
  columnName    String     @db.VarChar(100)
  columnComment String?    @db.VarChar(200)
  columnType    String     @db.VarChar(50)
  tsType        String?    @db.VarChar(50)
  isPk          Int?       @default(0)
  isRequired    Int?       @default(0)
  isList        Int?       @default(1)
  isForm        Int?       @default(1)
  formType      String?    @db.VarChar(50)
  queryType     String?    @db.VarChar(50)
  sort          Int        @default(0)
  dictType      String?    @db.VarChar(50)
  createTime    DateTime   @default(now())
  updateTime    DateTime   @updatedAt

  table         GenTable   @relation(fields: [tableId], references: [id])

  @@index([tableId])
  @@index([sort])
}

// ================== 系统租户模块 ==================

model SysTenant {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(100)
  code        String    @unique @db.VarChar(50)
  status      Int       @default(1)
  expireTime  DateTime?
  maxUsers    Int       @default(100)
  remark      String?   @db.VarChar(500)
  createTime  DateTime  @default(now())
  updateTime  DateTime  @updatedAt
}