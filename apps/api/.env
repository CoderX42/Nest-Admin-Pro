# Database
DATABASE_URL="mysql://root:password@localhost:3306/nest_admin_pro"

# JWT
JWT_SECRET="nest-admin-pro-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Redis
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# App
APP_PORT="3000"
APP_ENV="dev"

# File Upload
UPLOAD_DIR="./uploads"
MAX_IMAGE_SIZE=2097152
MAX_FILE_SIZE=104857600

# Mail (optional)
MAIL_HOST="smtp.example.com"
MAIL_PORT="587"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM=""

# WeChat MiniApp (optional)
WECHAT_APPID=""
WECHAT_SECRET=""